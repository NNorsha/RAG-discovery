{
  "name": "RAG-discovery",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements.txt",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Streamlit RAG App",
      "onAutoForward": "notify"
    }
  },
  "remoteEnv": {
    "EMBED_BACKEND": "api",
    "EMBED_MODEL": "embedding-3"
  }
}
